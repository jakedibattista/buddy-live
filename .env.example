# Root env.example -- copy per-app and per-service .env files from their own .env.example.
# This file documents the full surface area only.

# === Firebase (shared) ===
FIREBASE_PROJECT_ID=puck-buddy
FIREBASE_STORAGE_BUCKET=puck-buddy.firebasestorage.app

# === Web app (apps/buddy-live) ===
# Public (client) Firebase config -- safe to expose
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=puck-buddy.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=puck-buddy
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=puck-buddy.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# ElevenLabs Agent (created in their dashboard, points its custom_llm at the ADK service)
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=
# Server-side only
FIREBASE_ADMIN_PROJECT_ID=puck-buddy
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
GEMINI_API_KEY=

# === ADK service (services/buddy-live-adk) ===
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# URL of the existing modelforpuckbuddy Cloud Run API (analyze-video tool target)
MODELFORPUCKBUDDY_API_URL=https://puck-buddy-model-api-dev-22317830094.us-central1.run.app
# Service account JSON path (mounted in Cloud Run) -- not needed locally if you use ADC
GOOGLE_APPLICATION_CREDENTIALS=
