// ⚠️  Buddy Live ONLY — merge into modelforpuckbuddy/firebase/storage.rules
// before deploying. See docs/FIRESTORE_RULES.md and storage.rules.merged.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /live_sessions/{sessionId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 30 * 1024 * 1024;
    }
  }
}
