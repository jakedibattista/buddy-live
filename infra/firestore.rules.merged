rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Puck Buddy (existing) — kept verbatim from the live deployed rules.
    // Source of truth: github.com/jakedibattista/modelforpuckbuddy/firebase/firestore.rules
    // Last synced from live console: 2026-05-24
    // -------------------------------------------------------------------------

    match /users/{userId} {
      // Allow authenticated users to read any profile (needed for username uniqueness check)
      // Write only allowed to own profile
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Allow create: validate uid matches
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.id;

      // Single-current-video metadata document
      match /video/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        // Allow create/update/delete for authenticated owner
        // Note: Cloud Functions use Admin SDK which bypasses these rules
        // for writing server-owned fields like analysisResults, jobStatus, etc.
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // User-curated stats subcollection (my_stats)
      match /my_stats/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Daily activity history for streaks / habit tracking.
      match /activity_days/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Analytics events - allow authenticated users to write events
    match /analytics_events/{eventId} {
      allow create: if request.auth != null;
      allow read: if false;
    }

    // Completed analysis jobs. Users can read only their own historical
    // results; writes stay backend-only through the Admin SDK.
    match /jobs/{jobId} {
      allow get, list: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Preview/dev API writes completed analysis jobs here.
    match /jobs_dev/{jobId} {
      allow get, list: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ========== SCOREBOARD COLLECTIONS ==========
    // Daily scoreboards - read-only for authenticated users
    // Cloud Functions (Admin SDK) handle all writes
    match /scoreboards/{dateKey}/genders/{gender}/entries/{entryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Pre-computed rankings - read-only for authenticated users
    match /scoreboards/{dateKey}/rankings/{gender} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // App config (force-update gate) — readable by anyone, even unauthenticated
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Promo codes — all writes handled by Cloud Function (Admin SDK bypasses rules)
    // Client has no direct read/write access
    match /promo_codes/{code} {
      allow read, write: if false;
      match /redemptions/{userId} {
        allow read, write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Buddy Live (hackathon) — live coaching sessions
    // Added 2026-05; must stay ABOVE the catch-all deny below.
    // -------------------------------------------------------------------------
    match /live_sessions/{sessionId} {
      function sessionDoc() {
        return get(/databases/$(database)/documents/live_sessions/$(sessionId));
      }

      // Session doc: owner-scoped. Created by Vercel /api/session (Admin SDK)
      // or by client if we add that path later.
      allow create: if request.auth != null
                    && request.resource.data.user_id == request.auth.uid;
      allow read, update: if request.auth != null
                          && resource.data.user_id == request.auth.uid;
      allow delete: if false;

      // Rep scorecards: client listens; backend writes via Admin SDK.
      match /reps/{repId} {
        allow read: if request.auth != null
                    && sessionDoc().data.user_id == request.auth.uid;
        allow create, update, delete: if false;
      }

      // Capture commands: ADK writes; client reads + marks handled after recording.
      match /commands/{cmdId} {
        allow read: if request.auth != null
                    && sessionDoc().data.user_id == request.auth.uid;
        allow update: if request.auth != null
                      && sessionDoc().data.user_id == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handled']);
        allow create, delete: if false;
      }

      match /coach_log/{logId} {
        allow read: if request.auth != null
                    && sessionDoc().data.user_id == request.auth.uid;
        allow write: if false;
      }

      match /ambient_notes/{noteId} {
        allow read: if request.auth != null
                    && sessionDoc().data.user_id == request.auth.uid;
        allow write: if false;
      }
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
