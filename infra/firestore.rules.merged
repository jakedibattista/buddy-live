rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Puck Buddy (existing) — DO NOT MODIFY without reviewing modelforpuckbuddy
    // Source: github.com/jakedibattista/modelforpuckbuddy/firebase/firestore.rules
    // -------------------------------------------------------------------------

    // Jobs: users create for themselves, read their own status.
    // All state changes handled by backend worker (Admin SDK).
    match /jobs/{jobId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read:   if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Jobs (dev) — same rules, separate collection
    match /jobs_dev/{jobId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read:   if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // User profiles and subcollections (my_stats, video).
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      match /my_stats/{statId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      match /video/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // Scoreboards — public read, server-written.
    // Users can delete their own entry and update rankings (account deletion).
    match /scoreboards/{dateKey} {
      match /rankings/{gender} {
        allow read: if request.auth != null;
        allow update: if request.auth != null;
        allow create, delete: if false;
      }

      match /genders/{gender}/entries/{entryUserId} {
        allow read: if request.auth != null;
        allow delete: if request.auth != null
                      && request.auth.uid == entryUserId;
        allow create, update: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Buddy Live (hackathon) — live coaching sessions
    // Added 2026-05; must stay ABOVE the catch-all deny below.
    // -------------------------------------------------------------------------
    match /live_sessions/{sessionId} {
      function sessionDoc() {
        return get(/databases/$(database)/documents/live_sessions/$(sessionId));
      }

      // Session doc: owner-scoped. Created by Vercel /api/session (Admin SDK)
      // or by client if we add that path later.
      allow create: if request.auth != null
                    && request.resource.data.user_id == request.auth.uid;
      allow read, update: if request.auth != null
                          && resource.data.user_id == request.auth.uid;
      allow delete: if false;

      // Rep scorecards: client listens; backend writes via Admin SDK.
      match /reps/{repId} {
        allow read: if request.auth != null
                    && sessionDoc().data.user_id == request.auth.uid;
        allow create, update, delete: if false;
      }

      // Capture commands: ADK writes; client reads + marks handled after recording.
      match /commands/{cmdId} {
        allow read: if request.auth != null
                    && sessionDoc().data.user_id == request.auth.uid;
        allow update: if request.auth != null
                      && sessionDoc().data.user_id == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handled']);
        allow create, delete: if false;
      }

      match /coach_log/{logId} {
        allow read: if request.auth != null
                    && sessionDoc().data.user_id == request.auth.uid;
        allow write: if false;
      }

      match /ambient_notes/{noteId} {
        allow read: if request.auth != null
                    && sessionDoc().data.user_id == request.auth.uid;
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Catch-all deny. Admin SDK bypasses these rules.
    //
    // Admin-only collections (no client rule defined on purpose):
    //   - failed_jobs
    //   - statschat_sessions
    //   - api_keys
    //   - users/{uid}/revenuecat_events
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
